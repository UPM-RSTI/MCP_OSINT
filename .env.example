# === LLM ===
# API comercial (agente principal). Obtén la clave en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo local (Ollama). Debe estar corriendo: `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Timeout HTTP (segundos) de cada petición a Ollama — sin él, una petición que Ollama nunca
# responde cuelga el proceso indefinidamente.
TFM_OLLAMA_HTTP_TIMEOUT_S=90

# Proveedor por defecto: claude | ollama | bedrock
TFM_LLM_PROVIDER=ollama
TFM_CLAUDE_MODEL=claude-opus-4-8

# Amazon Bedrock (alternativa a ANTHROPIC_API_KEY para usar Claude, o para Amazon Nova):
# AWS_BEARER_TOKEN_BEDROCK y AWS_REGION son nombres estándar de AWS, no de este proyecto.
# Si tu clave es de las de corta duración (ligada a una sesión de consola AWS, caduca en
# horas), tendrás que volver a copiarla aquí cuando caduque — no es un fallo del sistema.
# Los ids de modelo se copian del catálogo de tu consola de Bedrock (varían por
# cuenta/región; los Claude recientes a veces exigen un inference profile
# 'us.anthropic...'/'eu.anthropic...' en vez del id "pelado").
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
TFM_BEDROCK_CLAUDE_MODEL=
TFM_BEDROCK_NOVA_MODEL=
# Modelo juez de evaluation/judge.py — de un proveedor DISTINTO a los motores comparados a
# propósito (evita sesgo de auto-preferencia). Por defecto DeepSeek V3.2, id "pelado", sin
# inference profile — funciona directo en bedrock-runtime. Verifica "Model access" en tu
# consola antes de asumir que un modelo recién lanzado (p. ej. Grok 4.6) está disponible: los
# modelos más nuevos suelen requerir aprobación explícita, no basta con verlos en el catálogo.
TFM_BEDROCK_JUDGE_MODEL=deepseek.v3.2
# 4º motor del pipeline principal (mismo linaje que Ollama — Qwen — pero grande y en la nube).
# Necesita us-east-1: no disponible en la región de arriba. Ver llm.py::_bedrock_region_for().
TFM_BEDROCK_QWEN_MODEL=qwen.qwen3-next-80b-a3b

# === Kafka (opcional, solo para la prueba de concepto de disparo por evento) ===
# scripts/kafka_consumer.py / kafka_produce_test_event.py / siem_simulador.py.
# Sin definir, usan localhost:9092 por defecto.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# === Fuentes OSINT (todas OPCIONALES) ===
# Sin ninguna clave ya funcionan 21 herramientas públicas de osint-mcp-server:
# DNS, WHOIS/RDAP, crt.sh, GeoIP, BGP/ASN, Wayback, HackerTarget, tenant M365.
# Estas claves (nombres exactos que lee el servidor) activan herramientas premium:
SHODAN_API_KEY=
VT_API_KEY=
ST_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
